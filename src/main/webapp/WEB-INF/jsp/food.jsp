<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Food Orders · AJT Hotel</title><style>*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:1180px;margin:26px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:20px;margin:16px 0}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}input,select,textarea{padding:10px;border:1px solid #ccd5e0;border-radius:7px;max-width:100%}.button{background:#1765c1;color:white;padding:10px 13px;border:0;border-radius:7px;cursor:pointer;text-decoration:none}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:9px;border-bottom:1px solid #e7ebf0}.scroll{overflow:auto}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media(max-width:750px){.grid{grid-template-columns:1fr 1fr}.scroll table{min-width:800px}}</style></head><body>
<header class="top"><h1>Food Menu & Orders</h1><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a> · <a href="${pageContext.request.contextPath}/laundry">Laundry</a> · <a href="${pageContext.request.contextPath}/room-service">Room Service</a> · <a href="${pageContext.request.contextPath}/logout">Logout</a></header><main>
<c:if test="${not empty success}"><div class="notice success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
<section class="card"><h2>Add Menu Item</h2><form method="post" action="${pageContext.request.contextPath}/food/items"><div class="grid"><input name="name" maxlength="120" placeholder="Food name" required><input name="category" maxlength="60" placeholder="Category" required><input name="price" type="number" min=".01" step=".01" placeholder="Price" required><input name="description" maxlength="500" placeholder="Description"><label><input type="checkbox" name="available" value="true" checked> Available</label><button class="button">Add Item</button></div></form></section>
<section class="card"><form method="get" action="${pageContext.request.contextPath}/food"><input name="q" value="<c:out value='${search}'/>" placeholder="Search menu"><select name="category"><option value="">All categories</option><c:forEach items="${foodCategories}" var="cat"><option value="<c:out value='${cat.category}'/>" <c:if test="${categoryFilter eq cat.category}">selected</c:if>><c:out value="${cat.category}"/></option></c:forEach></select><button class="button">Search / Filter</button></form></section>
<section class="card scroll"><h2>Menu Management</h2><table><thead><tr><th>Name</th><th>Category</th><th>Description</th><th>Price</th><th>Available</th><th>Save / Delete</th></tr></thead><tbody><c:forEach items="${foodItems}" var="item"><tr><td><input form="edit-food-${item.id}" name="name" value="<c:out value='${item.name}'/>" required></td><td><input form="edit-food-${item.id}" name="category" value="<c:out value='${item.category}'/>" required></td><td><input form="edit-food-${item.id}" name="description" value="<c:out value='${item.description}'/>"></td><td><input form="edit-food-${item.id}" name="price" type="number" min=".01" step=".01" value="${item.price}" required></td><td><input form="edit-food-${item.id}" name="available" type="checkbox" value="true" <c:if test="${item.available}">checked</c:if>></td><td><form id="edit-food-${item.id}" method="post" action="${pageContext.request.contextPath}/food/items/${item.id}"><button class="button">Save</button></form><form method="post" action="${pageContext.request.contextPath}/food/items/${item.id}/delete"><button class="button">Delete</button></form></td></tr></c:forEach></tbody></table></section>
<section class="card"><h2>Place Food Order</h2><p>Only checked-in bookings can order; choose one or more items and set each quantity.</p><form method="post" action="${pageContext.request.contextPath}/food/orders"><label>Checked-in booking <select name="reservationId" required><option value="">Select</option><c:forEach items="${checkedInBookings}" var="b"><option value="${b.id}">#${b.id} · <c:out value="${b.customer_name}"/> · Room <c:out value="${b.room_number}"/></option></c:forEach></select></label><div class="scroll"><table><thead><tr><th>Select</th><th>Item</th><th>Category</th><th>Price</th><th>Quantity</th></tr></thead><tbody><c:forEach items="${foodItems}" var="item"><c:if test="${item.available}"><tr><td><input type="checkbox" name="itemIds" value="${item.id}"></td><td><c:out value="${item.name}"/></td><td><c:out value="${item.category}"/></td><td>${item.price}</td><td><input type="number" name="quantity_${item.id}" min="1" max="100" value="1"></td></tr></c:if></c:forEach></tbody></table></div><button class="button">Place Order</button></form></section>
<section class="card scroll"><h2>Order History</h2><table><thead><tr><th>Order</th><th>Customer</th><th>Room</th><th>Total</th><th>Ordered</th><th>Status</th><th>Items</th></tr></thead><tbody><c:forEach items="${foodOrders}" var="o"><tr><td>#${o.id}</td><td><c:out value="${o.customer_name}"/></td><td><c:out value="${o.room_number}"/></td><td>${o.total}</td><td>${o.ordered_at}</td><td><form method="post" action="${pageContext.request.contextPath}/food/orders/${o.id}/status"><select name="status"><c:forEach items="${['PENDING','PREPARING','READY','SERVED','CANCELLED']}" var="s"><option value="${s}" <c:if test="${o.status eq s}">selected</c:if>><c:out value="${s}"/></option></c:forEach></select><button class="button">Update</button></form></td><td><c:forEach items="${foodOrderLines}" var="line"><c:if test="${line.order_id eq o.id}"><c:out value="${line.item_name}"/> × ${line.quantity} (${line.line_total})<br></c:if></c:forEach></td></tr></c:forEach></tbody></table></section></main></body></html>
