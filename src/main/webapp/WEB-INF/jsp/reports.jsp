<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Reports · AJT Hotel</title><style>body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:1200px;margin:26px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:20px;margin:16px 0}.button{background:#1765c1;color:white;padding:10px 13px;border:0;border-radius:7px;cursor:pointer}select,input{padding:10px;border:1px solid #ccd5e0;border-radius:7px}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:9px;border-bottom:1px solid #e7ebf0}.scroll{overflow:auto}.error{background:#ffeded;color:#991b1b;padding:12px}@media print{.top,.filters{display:none!important}body{background:white}}@media(max-width:700px){table{min-width:900px}}</style></head><body>
<header class="top"><h1>Reports</h1><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a> · <a href="${pageContext.request.contextPath}/billing">Billing</a></header><main>
<c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if><section class="card filters"><form method="get" action="${pageContext.request.contextPath}/reports"><select name="report"><c:forEach items="${['customers','rooms','bookings','check-ins','check-outs','food','laundry','room-service','employees','revenue','billing']}" var="name"><option value="${name}" <c:if test="${report eq name}">selected</c:if>><c:out value="${name}"/></option></c:forEach></select><label>From <input type="date" name="from" value="${from}"></label><label>To <input type="date" name="to" value="${to}"></label><button class="button">Run Report</button><button type="button" class="button" onclick="window.print()">Print</button></form></section>
<section class="card scroll"><h2><c:out value="${report}"/> report</h2><p>Records: ${recordCount}<c:if test="${report eq 'revenue' or report eq 'billing'}"> · Recorded payments: ${paidRevenue}</c:if></p><c:choose><c:when test="${empty rows}"><p>No persisted records found for this report and date range.</p></c:when><c:otherwise><table><thead><tr><c:forEach items="${rows[0]}" var="cell"><th><c:out value="${cell.key}"/></th></c:forEach></tr></thead><tbody><c:forEach items="${rows}" var="row"><tr><c:forEach items="${row}" var="cell"><td><c:out value="${cell.value}"/></td></c:forEach></tr></c:forEach></tbody></table></c:otherwise></c:choose></section></main></body></html>
