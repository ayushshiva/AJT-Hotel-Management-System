<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Bookings · AJT Hotel</title><style>*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:1150px;margin:28px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:20px;margin:16px 0}.bar{display:flex;justify-content:space-between;align-items:center}.button{background:#1765c1;color:white;padding:10px 14px;border:0;border-radius:7px;text-decoration:none;cursor:pointer}input,select{padding:10px;border:1px solid #ccd5e0;border-radius:7px}table{width:100%;border-collapse:collapse}th,td{text-align:left;padding:10px;border-bottom:1px solid #e7ebf0}.scroll{overflow:auto}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media(max-width:700px){table{min-width:950px}}</style></head><body>
<header class="top"><h1>Booking Management</h1><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a> · <a href="${pageContext.request.contextPath}/rooms">Rooms</a> · <a href="${pageContext.request.contextPath}/logout">Logout</a></header><main>
<c:if test="${not empty success}"><div class="notice success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
<section class="card bar"><h2>Reservations</h2><a class="button" href="${pageContext.request.contextPath}/booking-management/new">Create Booking</a></section>
<section class="card"><form method="get" action="${pageContext.request.contextPath}/booking-management"><input name="q" value="<c:out value='${search}'/>" placeholder="Search customer, phone or room">
<select name="status"><option value="">All statuses</option><c:forEach items="${['RESERVED','CHECKED_IN','CHECKED_OUT','CANCELLED']}" var="s"><option value="${s}" <c:if test="${statusFilter eq s}">selected</c:if>><c:out value="${s}"/></option></c:forEach></select><button class="button">Filter</button></form></section>
<section class="card scroll"><table><thead><tr><th>ID</th><th>Customer</th><th>Phone</th><th>Room</th><th>Stay</th><th>Nights</th><th>Room charge</th><th>Status</th><th>Actions</th></tr></thead><tbody>
<c:choose><c:when test="${empty reservations}"><tr><td colspan="9">No reservations found.</td></tr></c:when><c:otherwise><c:forEach items="${reservations}" var="r"><tr><td>${r.id}</td><td><c:out value="${r.customerName}"/></td><td><c:out value="${r.phone}"/></td><td><c:out value="${r.roomNumber}"/></td><td>${r.checkIn} – ${r.checkOut}</td><td>${r.nights}</td><td>${r.totalRoomCharges}</td><td><c:out value="${r.status}"/></td><td><a href="${pageContext.request.contextPath}/booking-management/${r.id}">View</a></td></tr></c:forEach></c:otherwise></c:choose>
</tbody></table></section></main></body></html>
