<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Room Service · AJT Hotel</title><style>*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:1150px;margin:26px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:20px;margin:16px 0}.grid{display:flex;gap:10px;flex-wrap:wrap}input,select,textarea{padding:10px;border:1px solid #ccd5e0;border-radius:7px}.button{background:#1765c1;color:white;padding:9px 12px;border:0;border-radius:7px;cursor:pointer}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:9px;border-bottom:1px solid #e7ebf0}.scroll{overflow:auto}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media(max-width:700px){table{min-width:1000px}}</style></head><body>
<header class="top"><h1>Room Service</h1><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a> · <a href="${pageContext.request.contextPath}/food">Food</a> · <a href="${pageContext.request.contextPath}/laundry">Laundry</a> · <a href="${pageContext.request.contextPath}/employees">Employees</a></header><main>
<c:if test="${not empty success}"><div class="notice success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
<section class="card"><h2>Create Service Request</h2><form method="post" action="${pageContext.request.contextPath}/room-service"><div class="grid"><select name="reservationId" required><option value="">Checked-in booking</option><c:forEach items="${checkedInBookings}" var="b"><option value="${b.id}">#${b.id} · <c:out value="${b.customer_name}"/> · Room ${b.room_number}</option></c:forEach></select><input name="serviceType" maxlength="80" placeholder="Service type" required><input name="description" maxlength="500" placeholder="Description"><input name="serviceCharge" type="number" min="0" step=".01" placeholder="Charge" required><button class="button">Create</button></div></form></section>
<section class="card scroll"><h2>Service History</h2><table><thead><tr><th>ID</th><th>Customer</th><th>Room</th><th>Service</th><th>Description</th><th>Charge</th><th>Staff</th><th>Assign</th><th>Status / Actions</th></tr></thead><tbody><c:forEach items="${requests}" var="r"><tr><td>${r.id}</td><td><c:out value="${r.customer_name}"/></td><td><c:out value="${r.room_number}"/></td><td><c:out value="${r.service_type}"/></td><td><c:out value="${r.description}"/></td><td>${r.service_charge}</td><td><c:out value="${r.employee_name}"/></td><td><c:if test="${r.status eq 'REQUESTED'}"><form method="post" action="${pageContext.request.contextPath}/room-service/${r.id}/assign"><select name="employeeId" required><option value="">Employee</option><c:forEach items="${employees}" var="e"><c:if test="${e.status eq 'ACTIVE'}"><option value="${e.id}"><c:out value="${e.full_name}"/></option></c:if></c:forEach></select><button class="button">Assign</button></form></c:if></td><td><form method="post" action="${pageContext.request.contextPath}/room-service/${r.id}/status"><select name="status"><c:forEach items="${['REQUESTED','ASSIGNED','IN_PROGRESS','COMPLETED','CANCELLED']}" var="s"><option value="${s}" <c:if test="${r.status eq s}">selected</c:if>><c:out value="${s}"/></option></c:forEach></select><button class="button">Update</button></form><c:if test="${r.status eq 'REQUESTED'}"><details><summary>Edit request</summary><form method="post" action="${pageContext.request.contextPath}/room-service/${r.id}"><select name="reservationId" required><c:forEach items="${checkedInBookings}" var="b"><option value="${b.id}" <c:if test="${b.room_number eq r.room_number}">selected</c:if>>#${b.id} · Room ${b.room_number}</option></c:forEach></select><input name="serviceType" value="<c:out value='${r.service_type}'/>" required><input name="description" value="<c:out value='${r.description}'/>"><input name="serviceCharge" type="number" min="0" step=".01" value="${r.service_charge}" required><button class="button">Save</button></form></details></c:if></td></tr></c:forEach></tbody></table></section></main></body></html>
