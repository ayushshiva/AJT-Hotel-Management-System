<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Employees · AJT Hotel</title><style>*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:1150px;margin:26px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:20px;margin:16px 0}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10px}input,select{padding:9px;border:1px solid #ccd5e0;border-radius:7px;max-width:150px}.button{background:#1765c1;color:white;padding:9px 12px;border:0;border-radius:7px;cursor:pointer}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:8px;border-bottom:1px solid #e7ebf0}.scroll{overflow:auto}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media(max-width:700px){.grid{grid-template-columns:1fr 1fr}table{min-width:1250px}}</style></head><body>
<header class="top"><h1>Employee Management</h1><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a> · <a href="${pageContext.request.contextPath}/room-service">Room Service</a> · <a href="${pageContext.request.contextPath}/logout">Logout</a></header><main>
<c:if test="${not empty success}"><div class="notice success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
<section class="card"><h2>Add Employee</h2><form method="post" action="${pageContext.request.contextPath}/employees"><div class="grid"><input name="fullName" placeholder="Full name" required><input name="mobileNumber" placeholder="Mobile" required><input name="email" type="email" placeholder="Email" required><input name="address" placeholder="Address"><select name="designation" required><option value="">Designation</option><c:forEach items="${['Manager','Receptionist','Accountant','Housekeeping','Room Service Staff','Kitchen Staff','Laundry Staff']}" var="d"><option><c:out value="${d}"/></option></c:forEach></select><input name="department" placeholder="Department" required><input name="salary" type="number" min="0" step=".01" placeholder="Salary" required><input name="joiningDate" type="date" required></div><button class="button">Add Employee</button></form></section>
<section class="card"><form method="get" action="${pageContext.request.contextPath}/employees"><input name="q" value="<c:out value='${search}'/>" placeholder="Search name, mobile, email"><select name="designation"><option value="">All designations</option><c:forEach items="${['Manager','Receptionist','Accountant','Housekeeping','Room Service Staff','Kitchen Staff','Laundry Staff']}" var="d"><option value="${d}" <c:if test="${designationFilter eq d}">selected</c:if>><c:out value="${d}"/></option></c:forEach></select><button class="button">Filter</button></form></section>
<section class="card scroll"><h2>Employee Records · Edit in place</h2><table><thead><tr><th>Name</th><th>Mobile</th><th>Email</th><th>Address</th><th>Designation</th><th>Department</th><th>Salary</th><th>Joining</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${employees}" var="e"><tr><td><input form="edit-employee-${e.id}" name="fullName" value="<c:out value='${e.full_name}'/>"></td><td><input form="edit-employee-${e.id}" name="mobileNumber" value="<c:out value='${e.mobile_number}'/>"></td><td><input form="edit-employee-${e.id}" name="email" value="<c:out value='${e.email}'/>"></td><td><input form="edit-employee-${e.id}" name="address" value="<c:out value='${e.address}'/>"></td><td><select form="edit-employee-${e.id}" name="designation"><c:forEach items="${['Manager','Receptionist','Accountant','Housekeeping','Room Service Staff','Kitchen Staff','Laundry Staff']}" var="d"><option value="${d}" <c:if test="${e.designation eq d}">selected</c:if>><c:out value="${d}"/></option></c:forEach></select></td><td><input form="edit-employee-${e.id}" name="department" value="<c:out value='${e.department}'/>"></td><td><input form="edit-employee-${e.id}" name="salary" type="number" min="0" step=".01" value="${e.salary}"></td><td><input form="edit-employee-${e.id}" name="joiningDate" type="date" value="${e.joining_date}"></td><td><c:out value="${e.status}"/></td><td><form id="edit-employee-${e.id}" method="post" action="${pageContext.request.contextPath}/employees"><input type="hidden" name="id" value="${e.id}"><button class="button">Save</button></form><c:if test="${e.status eq 'ACTIVE'}"><form method="post" action="${pageContext.request.contextPath}/employees/${e.id}/deactivate"><button class="button">Deactivate</button></form></c:if></td></tr></c:forEach></tbody></table></section></main></body></html>
