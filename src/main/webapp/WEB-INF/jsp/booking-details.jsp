<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Booking Details · AJT Hotel</title><style>body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:900px;margin:28px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:24px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}dt{font-size:12px;color:#64748b}dd{margin:5px 0 0}.button{display:inline-block;border:0;border-radius:7px;padding:10px 14px;background:#1765c1;color:white;text-decoration:none;cursor:pointer;margin:8px 8px 0 0}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media(max-width:620px){.grid{grid-template-columns:1fr}}</style></head><body>
<header class="top"><h1>Booking #${reservation.id}</h1><a href="${pageContext.request.contextPath}/booking-management">Booking Management</a> · <a href="${pageContext.request.contextPath}/dashboard">Dashboard</a></header><main>
<c:if test="${not empty success}"><p class="notice success"><c:out value="${success}"/></p></c:if><c:if test="${not empty error}"><p class="notice error"><c:out value="${error}"/></p></c:if>
<section class="card"><dl class="grid"><div><dt>Customer</dt><dd><c:out value="${reservation.customerName}"/></dd></div><div><dt>Phone</dt><dd><c:out value="${reservation.phone}"/></dd></div><div><dt>Room</dt><dd><c:out value="${reservation.roomNumber}"/></dd></div><div><dt>Status</dt><dd><c:out value="${reservation.status}"/></dd></div><div><dt>Check-in</dt><dd>${reservation.checkIn}</dd></div><div><dt>Check-out</dt><dd>${reservation.checkOut}</dd></div><div><dt>Nights</dt><dd>${reservation.nights}</dd></div><div><dt>Rate per night</dt><dd>${reservation.roomRate}</dd></div><div><dt>Room charges</dt><dd>${reservation.totalRoomCharges}</dd></div><div><dt>Booked</dt><dd>${reservation.bookingDate}</dd></div></dl>
<c:if test="${reservation.status eq 'RESERVED'}"><a class="button" href="${pageContext.request.contextPath}/booking-management/${reservation.id}/edit">Edit</a><form style="display:inline" method="post" action="${pageContext.request.contextPath}/booking-management/${reservation.id}/check-in"><button class="button">Check In</button></form><form style="display:inline" method="post" action="${pageContext.request.contextPath}/booking-management/${reservation.id}/cancel" onsubmit="return confirm('Cancel this reservation?');"><button class="button">Cancel Booking</button></form></c:if>
<c:if test="${reservation.status eq 'CHECKED_IN'}"><form method="post" action="${pageContext.request.contextPath}/booking-management/${reservation.id}/check-out"><button class="button">Check Out</button></form></c:if>
</section></main></body></html>
