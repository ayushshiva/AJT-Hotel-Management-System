<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Invoice · AJT Hotel</title><style>body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:850px;margin:26px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:24px;margin:16px 0}.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}.button{background:#1765c1;color:white;padding:10px 14px;border:0;border-radius:7px;cursor:pointer}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:9px;border-bottom:1px solid #e7ebf0}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media print{.top,.no-print{display:none!important}body{background:white}.card{box-shadow:none}}@media(max-width:600px){.grid{grid-template-columns:1fr}}</style></head><body>
<header class="top"><h1>Invoice <c:out value="${invoice.invoice_number}"/></h1><a href="${pageContext.request.contextPath}/billing">Billing</a></header><main>
<c:if test="${not empty success}"><p class="notice success"><c:out value="${success}"/></p></c:if><c:if test="${not empty error}"><p class="notice error"><c:out value="${error}"/></p></c:if><section class="card">
<div class="grid"><div><strong>Customer</strong><br><c:out value="${invoice.customer_name}"/></div><div><strong>Phone</strong><br><c:out value="${invoice.mobile_number}"/></div><div><strong>Booking</strong><br>#${invoice.reservation_id} · Room <c:out value="${invoice.room_number}"/></div><div><strong>Invoice date</strong><br>${invoice.invoice_date}</div></div>
<table><tr><th>Room charges</th><td>${invoice.room_charges}</td></tr><tr><th>Food charges</th><td>${invoice.food_charges}</td></tr><tr><th>Laundry charges</th><td>${invoice.laundry_charges}</td></tr><tr><th>Room service</th><td>${invoice.room_service_charges}</td></tr><tr><th>Subtotal</th><td>${invoice.subtotal}</td></tr><tr><th>GST (${invoice.gst_rate}%)</th><td>${invoice.gst_amount}</td></tr><tr><th>Grand total</th><td>${invoice.grand_total}</td></tr><tr><th>Paid</th><td>${invoice.paid_amount}</td></tr><tr><th>Outstanding balance</th><td>${invoice.outstanding_balance}</td></tr><tr><th>Payment status</th><td><c:out value="${invoice.payment_status}"/></td></tr></table>
<div class="no-print"><button class="button" onclick="window.print()">Print Invoice</button><c:if test="${invoice.payment_status ne 'PAID'}"><form method="post" action="${pageContext.request.contextPath}/billing/${invoice.id}/payments"><input name="amount" type="number" min=".01" step=".01" placeholder="Payment amount" required><select name="paymentMethod"><option>CASH</option><option>UPI</option><option>CARD</option></select><button class="button">Record Payment</button></form></c:if></div>
<h2>Payment History</h2><table><thead><tr><th>Amount</th><th>Method</th><th>Recorded</th></tr></thead><tbody><c:forEach items="${payments}" var="p"><tr><td>${p.amount}</td><td><c:out value="${p.payment_method}"/></td><td>${p.recorded_at}</td></tr></c:forEach></tbody></table></section></main></body></html>
