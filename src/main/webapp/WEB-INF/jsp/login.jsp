<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hotel Management - Login</title>
<style>*{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;background:linear-gradient(135deg,#102a43,#1765a8);font-family:Arial,sans-serif;color:#172033}.panel{width:min(420px,92vw);background:#fff;padding:34px;border-radius:16px;box-shadow:0 18px 55px #0003}h1{margin:0 0 8px;color:#173b64}p{color:#64748b}.field{margin:18px 0}label{display:block;margin-bottom:7px;font-weight:bold}input{width:100%;padding:13px;border:1px solid #cbd5e1;border-radius:8px;font-size:15px}button{width:100%;padding:13px;background:#1765c1;color:white;border:0;border-radius:8px;font-weight:bold;font-size:16px;cursor:pointer}.error{padding:11px;background:#fee2e2;color:#991b1b;border-radius:8px}</style></head><body>
<div class="panel"><h1>🏨 Hotel Management</h1><p>Administrator Sign In · AJT CSE Project</p>
<% if (request.getAttribute("error") != null) { %><div class="error"><%= request.getAttribute("error") %></div><% } %>
<form method="post" action="${pageContext.request.contextPath}/login"><div class="field"><label>Username</label><input name="username" autocomplete="username" required></div><div class="field"><label>Password</label><input type="password" name="password" autocomplete="current-password" required></div><button type="submit">Sign In</button></form>
<p style="font-size:13px;margin-top:20px">Demo login: <b>admin</b> / <b>admin123</b></p></div></body></html>
