<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Laundry · AJT Hotel</title><style>*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:1100px;margin:26px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:20px;margin:16px 0}.grid{display:flex;gap:10px;flex-wrap:wrap}input,select{padding:10px;border:1px solid #ccd5e0;border-radius:7px}.button{background:#1765c1;color:white;padding:10px 13px;border:0;border-radius:7px;cursor:pointer}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:10px;border-bottom:1px solid #e7ebf0}.scroll{overflow:auto}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media(max-width:700px){table{min-width:850px}}</style></head><body>
<header class="top"><h1>Laundry Management</h1><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a> · <a href="${pageContext.request.contextPath}/food">Food</a> · <a href="${pageContext.request.contextPath}/room-service">Room Service</a> · <a href="${pageContext.request.contextPath}/logout">Logout</a></header><main>
<c:if test="${not empty success}"><div class="notice success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
<section class="card"><h2>Create Request</h2><form method="post" action="${pageContext.request.contextPath}/laundry"><div class="grid"><select name="reservationId" required><option value="">Checked-in booking</option><c:forEach items="${checkedInBookings}" var="b"><option value="${b.id}">#${b.id} · <c:out value="${b.customer_name}"/> · Room ${b.room_number}</option></c:forEach></select><input name="itemName" maxlength="120" placeholder="Item name" required><input name="quantity" type="number" min="1" max="500" placeholder="Quantity" required><input name="ratePerItem" type="number" min="0" step=".01" placeholder="Rate per item" required><input name="expectedDeliveryDate" type="date"><button class="button">Create</button></div></form></section>
<section class="card"><form method="get" action="${pageContext.request.contextPath}/laundry"><input name="q" value="<c:out value='${search}'/>" placeholder="Customer or room"><button class="button">Search</button></form></section>
<section class="card scroll"><h2>Request History</h2><table><thead><tr><th>ID</th><th>Customer</th><th>Room</th><th>Item</th><th>Qty</th><th>Rate</th><th>Total</th><th>Expected</th><th>Status / Actions</th></tr></thead><tbody><c:forEach items="${requests}" var="r"><tr><td>${r.id}</td><td><c:out value="${r.customer_name}"/></td><td><c:out value="${r.room_number}"/></td><td><c:out value="${r.item_name}"/></td><td>${r.quantity}</td><td>${r.rate_per_item}</td><td>${r.total_amount}</td><td>${r.expected_delivery_date}</td><td><form method="post" action="${pageContext.request.contextPath}/laundry/${r.id}/status"><select name="status"><c:forEach items="${['RECEIVED','IN_PROGRESS','READY','DELIVERED','CANCELLED']}" var="s"><option value="${s}" <c:if test="${r.status eq s}">selected</c:if>><c:out value="${s}"/></option></c:forEach></select><button class="button">Update</button></form><c:if test="${r.status eq 'RECEIVED'}"><details><summary>Edit request</summary><form method="post" action="${pageContext.request.contextPath}/laundry/${r.id}"><select name="reservationId" required><c:forEach items="${checkedInBookings}" var="b"><option value="${b.id}" <c:if test="${b.room_number eq r.room_number}">selected</c:if>>#${b.id} · <c:out value="${b.customer_name}"/> · Room ${b.room_number}</option></c:forEach></select><input name="itemName" value="<c:out value='${r.item_name}'/>" required><input name="quantity" type="number" min="1" value="${r.quantity}" required><input name="ratePerItem" type="number" min="0" step=".01" value="${r.rate_per_item}" required><input name="expectedDeliveryDate" type="date" value="${r.expected_delivery_date}"><button class="button">Save</button></form></details></c:if></td></tr></c:forEach></tbody></table></section></main></body></html>
