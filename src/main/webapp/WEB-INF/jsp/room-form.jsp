<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Room · AJT Hotel</title>
<style>body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial,sans-serif}.top{background:#142d4e;color:white;padding:22px max(5%,calc((100% - 850px)/2))}.top a{color:white}main{max-width:850px;margin:28px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:24px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:15px}.field label{display:block;font-weight:bold;margin:0 0 6px}.field input,.field select,.field textarea{width:100%;padding:11px;border:1px solid #cbd5e1;border-radius:7px;font:inherit}.wide{grid-column:1/-1}.button{display:inline-block;border:0;border-radius:7px;padding:11px 15px;background:#1765c1;color:white;text-decoration:none;font-weight:bold;cursor:pointer}.error{background:#ffeded;color:#991b1b;padding:12px;border-radius:8px;margin-bottom:16px}.actions{display:flex;gap:10px;margin-top:20px}@media(max-width:620px){.grid{grid-template-columns:1fr}.wide{grid-column:auto}}</style></head><body>
<header class="top"><h1><c:choose><c:when test="${editing}">Edit Room</c:when><c:otherwise>Add Room</c:otherwise></c:choose></h1><a href="${pageContext.request.contextPath}/rooms">Room Management</a></header><main><section class="card">
<c:if test="${not empty error}"><div class="error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/rooms${editing ? '/' : ''}${editing ? room.id : ''}"><div class="grid">
<div class="field"><label for="roomNumber">Room number *</label><input id="roomNumber" name="roomNumber" maxlength="12" value="<c:out value='${room.roomNumber}'/>" required></div>
<div class="field"><label for="roomType">Room type *</label><select id="roomType" name="roomType" required><c:forEach items="${['Single','Double','Deluxe','Suite']}" var="type"><option value="${type}" <c:if test="${room.roomType eq type}">selected</c:if>><c:out value="${type}"/></option></c:forEach></select></div>
<div class="field"><label for="floorNumber">Floor *</label><input id="floorNumber" name="floorNumber" type="number" min="0" value="${room.floorNumber}" required></div>
<div class="field"><label for="capacity">Capacity *</label><input id="capacity" name="capacity" type="number" min="1" value="${room.capacity gt 0 ? room.capacity : 1}" required></div>
<div class="field"><label for="pricePerNight">Price per night *</label><input id="pricePerNight" name="pricePerNight" type="number" min="0.01" step="0.01" value="${room.pricePerNight}" required></div>
<div class="field"><label for="status">Status</label><select id="status" name="status"><c:forEach items="${['AVAILABLE','RESERVED','OCCUPIED','MAINTENANCE']}" var="status"><option value="${status}" <c:if test="${room.status eq status}">selected</c:if>><c:out value="${status}"/></option></c:forEach></select></div>
<div class="field wide"><label for="description">Description</label><textarea id="description" name="description" maxlength="500"><c:out value="${room.description}"/></textarea></div>
<div class="field wide"><label for="amenities">Amenities</label><textarea id="amenities" name="amenities" maxlength="500"><c:out value="${room.amenities}"/></textarea></div>
</div><div class="actions"><button class="button">Save Room</button><a class="button" href="${pageContext.request.contextPath}/rooms">Cancel</a></div></form></section></main></body></html>
