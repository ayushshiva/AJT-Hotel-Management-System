<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Room Details · AJT Hotel</title><style>body{font:15px Arial;background:#f3f6fb;color:#172033;margin:0}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:900px;margin:28px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:24px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}dt{color:#64748b;font-size:12px}dd{margin:5px 0 0}.button{display:inline-block;background:#1765c1;color:white;border-radius:7px;padding:10px 15px;text-decoration:none;margin-top:18px}.success{background:#e4f7e9;padding:12px}.error{background:#ffeded;padding:12px}@media(max-width:620px){.grid{grid-template-columns:1fr}}</style></head><body>
<header class="top"><h1>Room <c:out value="${room.roomNumber}"/></h1><a href="${pageContext.request.contextPath}/rooms">Room Management</a> · <a href="${pageContext.request.contextPath}/dashboard">Dashboard</a></header><main>
<c:if test="${not empty success}"><p class="success"><c:out value="${success}"/></p></c:if><c:if test="${not empty error}"><p class="error"><c:out value="${error}"/></p></c:if><section class="card"><dl class="grid">
<div><dt>Room ID</dt><dd>${room.id}</dd></div><div><dt>Status</dt><dd><c:out value="${room.status}"/></dd></div><div><dt>Type</dt><dd><c:out value="${room.roomType}"/></dd></div><div><dt>Floor</dt><dd>${room.floorNumber}</dd></div><div><dt>Capacity</dt><dd>${room.capacity}</dd></div><div><dt>Price / night</dt><dd>${room.pricePerNight}</dd></div><div><dt>Description</dt><dd><c:out value="${room.description}"/></dd></div><div><dt>Amenities</dt><dd><c:out value="${room.amenities}"/></dd></div><div><dt>Created</dt><dd>${room.createdAt}</dd></div></dl><a class="button" href="${pageContext.request.contextPath}/rooms/${room.id}/edit">Edit Room</a><a class="button" href="${pageContext.request.contextPath}/booking-management/new">Create Booking</a></section></main></body></html>
