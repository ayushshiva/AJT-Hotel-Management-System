<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Billing · AJT Hotel</title><style>*{box-sizing:border-box}body{margin:0;background:#f3f6fb;color:#172033;font:15px Arial}.top{background:#142d4e;color:white;padding:22px 5%}.top a{color:white}main{max-width:1120px;margin:26px auto;padding:0 18px}.card{background:white;border-radius:12px;padding:20px;margin:16px 0}.button{background:#1765c1;color:white;padding:10px 13px;border:0;border-radius:7px;text-decoration:none;cursor:pointer}select{padding:10px;border:1px solid #ccd5e0;border-radius:7px}table{width:100%;border-collapse:collapse}td,th{text-align:left;padding:10px;border-bottom:1px solid #e7ebf0}.scroll{overflow:auto}.notice{padding:12px}.error{background:#ffeded;color:#991b1b}.success{background:#e4f7e9;color:#17613b}@media(max-width:700px){table{min-width:950px}}</style></head><body>
<header class="top"><h1>Billing & Invoices</h1><a href="${pageContext.request.contextPath}/dashboard">Dashboard</a> · <a href="${pageContext.request.contextPath}/reports">Reports</a> · <a href="${pageContext.request.contextPath}/logout">Logout</a></header><main>
<c:if test="${not empty success}"><div class="notice success"><c:out value="${success}"/></div></c:if><c:if test="${not empty error}"><div class="notice error"><c:out value="${error}"/></div></c:if>
<section class="card"><h2>Generate invoice for checked-out booking</h2><form method="post" action="${pageContext.request.contextPath}/billing"><select name="reservationId" required><option value="">Select completed booking</option><c:forEach items="${completedBookings}" var="b"><option value="${b.id}">#${b.id} · <c:out value="${b.customer_name}"/> · Room ${b.room_number} · Room charges ${b.total_room_charges}</option></c:forEach></select><select name="paymentMethod" required><option value="CASH">CASH</option><option value="UPI">UPI</option><option value="CARD">CARD</option></select><button class="button">Generate Invoice (GST 18%)</button></form><p>Invoice is generated once per completed booking and uses persisted served food, delivered laundry, and completed room-service charges.</p></section>
<section class="card scroll"><h2>Invoice History</h2><table><thead><tr><th>Invoice</th><th>Customer</th><th>Room</th><th>Subtotal</th><th>GST</th><th>Total</th><th>Payment</th><th>Date</th></tr></thead><tbody><c:forEach items="${invoices}" var="i"><tr><td><a href="${pageContext.request.contextPath}/billing/${i.id}"><c:out value="${i.invoice_number}"/></a></td><td><c:out value="${i.customer_name}"/></td><td><c:out value="${i.room_number}"/></td><td>${i.subtotal}</td><td>${i.gst_amount}</td><td>${i.grand_total}</td><td><c:out value="${i.payment_status}"/></td><td>${i.invoice_date}</td></tr></c:forEach></tbody></table></section></main></body></html>
